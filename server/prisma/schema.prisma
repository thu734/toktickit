generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ITPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ActionStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum ActionEventType {
  CREATED
  UPDATED
  ASSIGNED
  COMPLETED
  CANCELLED
  CORRECTED
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole @default(REQUESTER)
  mustChangePassword Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tickets            Ticket[]       @relation("TicketRequester")
  assignedTickets    Ticket[]       @relation("TicketAssignedStaff")
  comments           Comment[]
  internalNotes      InternalNote[]
  removedAttachments Attachment[]   @relation("RemovedByUser")
  performedActions   ActionTaken[]  @relation("ActionPerformer")
  assignedActions    ActionTaken[]  @relation("ActionAssignee")
  actionEvents       ActionAuditEvent[]

  @@map("users")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@map("categories")
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@map("related_systems")
}

model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique
  summary           String
  description       String
  requestedPriority RequestedPriority @default(MEDIUM)
  itPriority        ITPriority        @default(MEDIUM)
  currentStatus     TicketStatus      @default(NEW)
  resolutionSummary String?
  workflowRevision  Int               @default(0)

  requesterId     Int
  requester       User          @relation("TicketRequester", fields: [requesterId], references: [id])

  assignedStaffId Int?
  assignedStaff   User?         @relation("TicketAssignedStaff", fields: [assignedStaffId], references: [id])

  categoryId      Int
  category        Category      @relation(fields: [categoryId], references: [id])

  relatedSystemId Int
  relatedSystem   RelatedSystem @relation(fields: [relatedSystemId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  attachments     Attachment[]
  comments        Comment[]
  internalNotes   InternalNote[]
  actions         ActionTaken[]

  @@index([requesterId])
  @@index([assignedStaffId])
  @@index([currentStatus])
  @@index([itPriority])
  @@index([categoryId])
  @@index([createdAt])
  @@map("tickets")
}

model Attachment {
  id                   Int       @id @default(autoincrement())
  filename             String
  storedFilename       String    @unique
  mimeType             String
  fileSize             Int
  filePath             String

  isRemoved            Boolean   @default(false)
  removedAt            DateTime?
  removalReason        String?

  ticketId             Int
  ticket               Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  removedByRequesterId Int?
  removedByRequester   User?     @relation("RemovedByUser", fields: [removedByRequesterId], references: [id])

  createdAt            DateTime  @default(now())

  @@index([ticketId])
  @@index([ticketId, isRemoved])
  @@map("attachments")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("comments")
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  content   String
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("internal_notes")
}

model ActionTaken {
  id               Int          @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedById    Int
  performedBy      User         @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  assignedToId     Int?
  assignedTo       User?        @relation("ActionAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  status           ActionStatus @default(PLANNED)
  description      String       @db.VarChar(2000)
  result           String?      @db.VarChar(2000)
  followUpRequired Boolean      @default(false)
  followUpNote     String?      @db.VarChar(1000)
  attachmentNotes  String?      @db.VarChar(1000)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  events           ActionAuditEvent[]
  creationRequest  ActionCreationRequest?

  // Also anchors the retry record to the same Ticket and authenticated creator.
  @@unique([id, ticketId, performedById])
  @@index([ticketId, createdAt, id])
  @@index([assignedToId, status])
  @@index([ticketId, status, followUpRequired])
  @@map("actions_taken")
}

model ActionAuditEvent {
  id            Int             @id @default(autoincrement())
  actionId      Int
  action        ActionTaken     @relation(fields: [actionId], references: [id], onDelete: Restrict)
  actorId       Int
  actor         User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  timestamp     DateTime        @default(now())
  eventType     ActionEventType
  changedFields Json

  @@index([actionId, timestamp, id])
  @@map("action_audit_events")
}

model ActionCreationRequest {
  id             Int         @id @default(autoincrement())
  actionId       Int         @unique
  ticketId       Int
  creatorId      Int
  action         ActionTaken @relation(fields: [actionId, ticketId, creatorId], references: [id, ticketId, performedById], onDelete: Restrict, onUpdate: Restrict)
  requestKey     String
  requestHash    String
  originalResult Json
  createdAt      DateTime    @default(now())

  @@unique([creatorId, ticketId, requestKey])
  @@unique([actionId, ticketId, creatorId])
  @@map("action_creation_requests")
}
